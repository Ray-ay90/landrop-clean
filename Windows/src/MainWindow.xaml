                        <Button Style="{StaticResource SecondaryButton}" Tag="#00FF00" Click="EdgeOverlayColorPresetButton_Click" Padding="8,8" Margin="0,0,6,0" AutomationProperties.Name="绿色"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Border Width="9" Height="9" CornerRadius="4.5" Background="#00FF00" Tag="ThemePreview" Margin="0,0,7,0" /><TextBlock Text="绿" /></StackPanel></Button>
                        <Button Style="{StaticResource SecondaryButton}" Tag="#0099FF" Click="EdgeOverlayColorPresetButton_Click" Padding="8,8" AutomationProperties.Name="蓝色"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Border Width="9" Height="9" CornerRadius="4.5" Background="#0099FF" Tag="ThemePreview" Margin="0,0,7,0" /><TextBlock Text="蓝" /></StackPanel></Button>
                      </UniformGrid>
                      <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="124" /><ColumnDefinition Width="10" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                        <TextBlock Text="自定义颜色" VerticalAlignment="Center" />
