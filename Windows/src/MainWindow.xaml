                        <Border x:Name="EdgeOverlayColorPreview" Grid.Column="3" Height="34" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Tag="ThemePreview" />
                      </Grid>
                      <TextBlock x:Name="EdgeOverlayColorHint" Text="输入 #RRGGBB 格式的六位颜色值。" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
