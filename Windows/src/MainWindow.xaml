            </Grid.RowDefinitions>
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBox x:Name="NoteTitleBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="22" FontWeight="SemiBold" Padding="0,6" TextChanged="NoteTitleBox_TextChanged" />
              <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="插入图片" Click="InsertImageButton_Click" />
                <Button Style="{StaticResource PrimaryButton}" Content="保存" Margin="10,0,0,0" Click="SaveNoteButton_Click" />
              </StackPanel>
            </Grid>
            <Grid Grid.Row="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                <RichTextBox x:Name="NoteEditor" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryTextBrush}" CaretBrush="{DynamicResource PrimaryTextBrush}" FontSize="18" IsDocumentEnabled="True" TextChanged="NoteEditor_TextChanged" SelectionChanged="NoteEditor_SelectionChanged" PreviewMouseLeftButtonDown="NoteEditor_PreviewMouseLeftButtonDown" PreviewMouseMove="NoteEditor_PreviewMouseMove" PreviewMouseLeftButtonUp="NoteEditor_PreviewMouseLeftButtonUp" />
              </Border>
              <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="NoteUndoButton" Style="{StaticResource SecondaryButton}" Content="撤销" Padding="12,7" Focusable="False" Click="NoteUndoButton_Click" />
                  <Button x:Name="NoteRedoButton" Style="{StaticResource SecondaryButton}" Content="重做" Padding="12,7" Margin="8,0,0,0" Focusable="False" Click="NoteRedoButton_Click" />
                  <Button Style="{StaticResource SecondaryButton}" Content="待办" Padding="12,7" Margin="8,0,18,0" Focusable="False" ToolTip="为当前行添加或移除待办框" Click="ToggleNoteChecklistButton_Click" />
                  <TextBlock Text="字号" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <Button Style="{StaticResource SecondaryButton}" Content="−" Width="34" Padding="0,7" Focusable="False" Click="DecreaseNoteFontSizeButton_Click" />
                  <TextBlock x:Name="NoteFontSizeText" Text="18" Foreground="{DynamicResource PrimaryTextBrush}" Width="34" TextAlignment="Center" VerticalAlignment="Center" />
                  <Button Style="{StaticResource SecondaryButton}" Content="+" Width="34" Padding="0,7" Focusable="False" Click="IncreaseNoteFontSizeButton_Click" />
                  <TextBlock Text="行距" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="18,0,8,0" />
                  <Button Style="{StaticResource SecondaryButton}" Content="−" Width="34" Padding="0,7" Focusable="False" Click="DecreaseNoteLineSpacingButton_Click" />
                  <TextBlock x:Name="NoteLineSpacingText" Text="1.3" Foreground="{DynamicResource PrimaryTextBrush}" Width="38" TextAlignment="Center" VerticalAlignment="Center" />
                  <Button Style="{StaticResource SecondaryButton}" Content="+" Width="34" Padding="0,7" Focusable="False" Click="IncreaseNoteLineSpacingButton_Click" />
                  <TextBlock Text="字距" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="18,0,8,0" />
                  <Button Style="{StaticResource SecondaryButton}" Content="−" Width="34" Padding="0,7" Focusable="False" Click="DecreaseNoteLetterSpacingButton_Click" />
                  <TextBlock x:Name="NoteLetterSpacingText" Text="0.02" Foreground="{DynamicResource PrimaryTextBrush}" Width="42" TextAlignment="Center" VerticalAlignment="Center" />
                  <Button Style="{StaticResource SecondaryButton}" Content="+" Width="34" Padding="0,7" Focusable="False" Click="IncreaseNoteLetterSpacingButton_Click" />
                  <Button Style="{StaticResource TextButton}" Content="舒适默认" Padding="10,7" Margin="14,0,0,0" Focusable="False" Click="ResetNoteTypographyButton_Click" />
                </StackPanel>
                </ScrollViewer>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
