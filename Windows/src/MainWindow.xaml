                      <StackPanel Grid.Column="2"><TextBlock Text="垂直偏移 Y" /><TextBox x:Name="CrosshairPositionYBox" Height="34" Margin="0,8,0,0" MaxLength="11" VerticalContentAlignment="Center" TextChanged="CrosshairPositionBox_TextChanged" AutomationProperties.Name="准心垂直偏移" /></StackPanel>
