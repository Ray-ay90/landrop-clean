<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="LanDrop.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="Assets/app.ico" Title="局域投送" Width="1240" Height="800" MinWidth="980" MinHeight="680" Background="Transparent" AllowsTransparency="True" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip" PreviewKeyDown="MainWindow_PreviewKeyDown">
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="232" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Border x:Name="SidebarPanel" Grid.RowSpan="2" Background="{DynamicResource TopBarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid Margin="12,12,12,14">
          <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Button Style="{StaticResource BrandButton}" HorizontalAlignment="Left" Click="BackHomeTopButton_Click" AutomationProperties.Name="局域投送首页">
            <StackPanel Orientation="Horizontal"><Image Source="Assets/brand-v.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" /><TextBlock Text="局域投送" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <StackPanel Grid.Row="1">
            <Button x:Name="ConnectionSigilButton" Style="{StaticResource NavButton}" Margin="0,8,0,22" AutomationProperties.Name="连接新设备" Click="OpenConnectionButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26" /><TextBlock Text="连接新设备" /></StackPanel></Button>
            <TextBlock Text="工作区" Style="{StaticResource NavCaption}" Margin="12,0,0,9" />
            <Button x:Name="RecentNavButton" Style="{StaticResource ActiveNavButton}" AutomationProperties.Name="最近传输" Click="OpenRecentTransfersButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26" /><TextBlock Text="最近传输" /></StackPanel></Button>
            <Button x:Name="ArchiveButton" Style="{StaticResource NavButton}" AutomationProperties.Name="本地记录" Click="OpenNotesButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26" /><TextBlock Text="本地记录" /></StackPanel></Button>
            <Button x:Name="MindMapNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="任务" Click="OpenTasksButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26" /><TextBlock Text="任务" /></StackPanel></Button>
            <Button x:Name="TrashNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="回收站" Click="OpenTrashButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26" /><TextBlock Text="回收站" /></StackPanel></Button>
            <TextBlock Text="工具" Style="{StaticResource NavCaption}" Margin="12,26,0,9" />
            <Button x:Name="CrosshairNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="屏幕准心" Click="OpenCrosshairSettingsButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81D;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26" /><TextBlock Text="屏幕准心" /></StackPanel></Button>
            <Button x:Name="EdgeOverlayNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="边缘叠加" Click="OpenEdgeOverlaySettingsButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26" /><TextBlock Text="边缘叠加" /></StackPanel></Button>
          </StackPanel>
          <StackPanel Grid.Row="2">
            <Button x:Name="PreferencesNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="偏好设置" Click="OpenPreferencesButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26" /><TextBlock Text="偏好设置" /></StackPanel></Button>
            <Grid Margin="12,16,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Ellipse x:Name="HomeFooterDot" Fill="{DynamicResource MutedTextBrush}" Width="6" Height="6" Margin="0,0,9,0" VerticalAlignment="Center" /><TextBlock x:Name="HomeStatusText" Grid.Column="1" Text="正在启动" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" /></Grid>
          </StackPanel>
        </Grid>
      </Border>
      <Border x:Name="WorkspaceTitleBar" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,140,0">
            <Button x:Name="SidebarToggleButton" Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="收起侧栏" AutomationProperties.Name="收起侧栏" Click="ToggleSidebarButton_Click"><TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="15" /></Button>
            <TextBlock Text="工作区" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="16,0,0,0" /><TextBlock Text="/" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="10,0" /><TextBlock x:Name="WorkspaceTitleText" Text="最近传输" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Style="{StaticResource ChromeButton}" Width="42" Content="−" ToolTip="最小化" AutomationProperties.Name="最小化" Click="MinimizeButton_Click" /><Button Style="{StaticResource ChromeButton}" Width="42" ToolTip="最大化或还原" AutomationProperties.Name="最大化或还原" Click="MaximizeButton_Click"><TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" /></Button><Button Style="{StaticResource CloseChromeButton}" Width="42" Content="×" ToolTip="关闭" AutomationProperties.Name="关闭" Click="CloseButton_Click" /></StackPanel>
        </Grid>
      </Border>
      <Grid x:Name="WorkspaceGrid" Grid.Row="1" Grid.Column="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="0" /><ColumnDefinition Width="216" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid Grid.Column="1" Grid.ColumnSpan="2" x:Name="HomeView" Background="{DynamicResource SurfaceBrush}">
          <Grid Margin="40,28,40,28">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="最近传输" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="文件与文字，在你的设备之间。" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,7,0,0" /></StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,24">
              <Image Source="Assets/brand-v.png" Width="48" Height="48" Opacity="0.85" RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock Text="准备好接收内容" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="24" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,22,0,0" /><TextBlock Text="连接手机后，在这里查看文件与文字传输。" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="传输活动" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" /><TextBlock x:Name="RecentStatusText" Text="等待设备连接" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" /><ScrollViewer Grid.Row="2" MaxHeight="160" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="LogText" Text="等待手机扫码或自动连接……" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" /></ScrollViewer></Grid>
            </Border>
          </Grid>
        </Grid>
        <Grid x:Name="ConnectionOverlay" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}">
          <ScrollViewer x:Name="ConnectionDialogScrollViewer" MaxWidth="590" Margin="24" VerticalAlignment="Center" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Background="#181A1C" BorderBrush="#363A3E" BorderThickness="1" CornerRadius="10" Padding="28">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="18" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="18" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                  <StackPanel>
                    <TextBlock Text="连接新设备" Foreground="#F5F6F6" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock Text="使用手机端扫描二维码。" Margin="0,7,0,0" Foreground="#858C91" FontSize="12" />
                  </StackPanel>
                  <Button Style="{StaticResource IconButton}" Content="×" HorizontalAlignment="Right" Click="BackToHomeButton_Click" />
                </Grid>
                <Border Grid.Row="2" Background="#111315" BorderBrush="#303438" BorderThickness="1" CornerRadius="8" Padding="16" HorizontalAlignment="Center">
                  <Border Background="#F5F6F5" CornerRadius="4" Padding="12">
                    <Image x:Name="QrImage" Width="230" Height="230" Stretch="Uniform" />
                  </Border>
                </Border>
                <StackPanel Grid.Row="4">
                  <ComboBox x:Name="AddressComboBox" SelectionChanged="AddressComboBox_SelectionChanged" />
                  <Border x:Name="StatusCard" Background="#1E2123" BorderBrush="#303438" BorderThickness="1" CornerRadius="6" Padding="11" Margin="0,12,0,18">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#858B90" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <TextBlock x:Name="StatusText" Text="正在启动接收服务……" Foreground="#A7ADB1" FontSize="12" />
                    </StackPanel>
                  </Border>
                  <TextBlock Text="最近传输" Foreground="#F0F1F1" FontWeight="SemiBold" />
                  <Border Background="#121416" BorderBrush="#2A2D30" BorderThickness="1" CornerRadius="6" Margin="0,10,0,0" Padding="12">
                    <TextBlock x:Name="OverlayRecentText" Text="连接成功后将显示最近传输。" Foreground="#777E83" FontSize="12" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Grid>
            </Border>
          </ScrollViewer>
        </Grid>
        <Grid x:Name="DeviceView" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}">
          <Grid Margin="32,28,32,28">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="34" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="连接设备" Foreground="#F4F5F5" FontSize="22" FontWeight="SemiBold" />
              <TextBlock x:Name="PeerText" Text="尚未连接设备" Foreground="#8A9196" FontSize="13" Margin="0,8,0,0" />
            </StackPanel>
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
              </Grid.ColumnDefinitions>
              <Border Background="#151719" BorderBrush="#292D30" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,0,20,0">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid>
                    <TextBlock Text="收到的文件和文字" Foreground="#E8EAEB" FontWeight="SemiBold" />
                    <Button x:Name="SendFileButton" Style="{StaticResource SecondaryButton}" Content="发送文件" HorizontalAlignment="Right" IsEnabled="False" Click="SendFileButton_Click" />
                  </Grid>
                  <Border Grid.Row="2" Background="#111315" CornerRadius="6" Padding="14">
                    <TextBlock x:Name="DeviceLogText" Text="设备连接后，传输记录将显示在这里。" TextWrapping="Wrap" Foreground="#A1A7AB" FontSize="12" />
                  </Border>
                  <Grid Grid.Row="3" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="78" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MessageBox" Background="#1C1F21" BorderBrush="#34383C" Foreground="#E7E9EA" Padding="11" VerticalContentAlignment="Center" />
                    <Button x:Name="SendTextButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="发送" Margin="10,0,0,0" IsEnabled="False" Click="SendTextButton_Click" />
                  </Grid>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1">
                <Border Background="#151719" BorderBrush="#292D30" BorderThickness="1" CornerRadius="8" Padding="18">
                  <StackPanel>
                    <TextBlock Text="接收进度" Foreground="#E8EAEB" FontWeight="SemiBold" />
                    <TextBlock x:Name="ProgressFileText" Text="暂无接收任务" Foreground="#A4AAAE" FontSize="12" Margin="0,18,0,0" />
                    <TextBlock x:Name="ProgressBytesText" Text="0 字节 / 0 字节" Foreground="#747C81" FontSize="11" Margin="0,5,0,0" />
                    <ProgressBar x:Name="ReceiveProgressBar" Style="{StaticResource DarkProgress}" Margin="0,11,0,0" />
                    <TextBlock x:Name="ProgressStatusText" Text="等待文件" Foreground="#858C91" FontSize="11" Margin="0,8,0,0" />
                  </StackPanel>
                </Border>
                <Border Background="#151719" BorderBrush="#292D30" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,16,0,0">
                  <StackPanel>
                    <TextBlock Text="保存目录" Foreground="#E8EAEB" FontWeight="SemiBold" />
                    <TextBlock Text="接收到的文件将保存至此位置。" Foreground="#727A7F" FontSize="11" Margin="0,7,0,10" />
                    <TextBox x:Name="ReceiveDirectoryBox" Background="#1C1F21" BorderBrush="#34383C" Foreground="#D9DCDE" FontSize="11" LostFocus="ReceiveDirectoryBox_LostFocus" KeyDown="ReceiveDirectoryBox_KeyDown" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                      <Button Style="{StaticResource SecondaryButton}" Content="更改目录" Click="ChooseFolderButton_Click" />
                      <Button Style="{StaticResource TextButton}" Content="打开文件夹" Margin="12,0,0,0" Click="OpenFolderButton_Click" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Background="#151719" BorderBrush="#292D30" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,16,0,0">
                  <StackPanel>
                    <TextBlock Text="手动同步" Foreground="#E8EAEB" FontWeight="SemiBold" />
                    <TextBlock Text="文本记录和任务只在 Android 端点击“同步全部”时双向交换。" Foreground="#727A7F" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
                    <Button x:Name="SyncNotesButton" Visibility="Collapsed" />
                    <TextBlock x:Name="SyncNotesStatusText" Text="等待 Android 发起同步" Foreground="#858C91" FontSize="11" Margin="0,10,0,0" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
        <Grid x:Name="PreferencesView" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}">
          <Grid Margin="32,28,32,28">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="28" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="偏好设置" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="22" FontWeight="SemiBold" />
              <TextBlock x:Name="PreferencesSubtitleText" Text="选择应用的外观主题。" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0" FontSize="12" />
            </StackPanel>
            <Grid Grid.Row="2">
              <Grid x:Name="PreferencesHomePanel" VerticalAlignment="Top" MaxWidth="760" HorizontalAlignment="Left">

                <Button x:Name="OpenThemeSettingsButton" Style="{StaticResource TextButton}" Padding="16,22" HorizontalContentAlignment="Stretch" Click="OpenThemeSettingsButton_Click">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" /><StackPanel Grid.Column="1"><TextBlock Text="主题" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="银白、日式与死亡搁浅。" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,24,0" FontSize="12" /></StackPanel><TextBlock x:Name="CurrentThemeText" Grid.Column="2" Text="当前：银白  ›" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" /></Grid>
                </Button>
              </Grid>
              <Grid x:Name="ThemeSettingsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="18" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button Style="{StaticResource TextButton}" Content="‹ 返回偏好设置" HorizontalAlignment="Left" Click="BackToPreferencesHomeButton_Click" />
                <StackPanel Grid.Row="2">
                  <TextBlock Text="选择主题" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="主题会立即应用，并在下次打开应用时保持。" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,6,0,18" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource PreferenceCard}" Tag="Night" Click="ThemeChoiceButton_Click">
                      <StackPanel>
                        <Border Height="74" Background="{DynamicResource SurfaceBrush}" BorderBrush="#DDE1E3" BorderThickness="1" CornerRadius="5" />
                        <TextBlock Text="夜航" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,0" />
                        <TextBlock Text="深色石墨，清晰专注" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource PreferenceCard}" Tag="Mist" Click="ThemeChoiceButton_Click">
                      <StackPanel>
                        <Border Height="74" Background="#EEF2F5" BorderBrush="#A9B5C0" BorderThickness="1" CornerRadius="5" />
                        <TextBlock Text="晨雾" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,0" />
                        <TextBlock Text="明亮冷灰，轻盈通透" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource PreferenceCard}" Tag="Forest" Click="ThemeChoiceButton_Click">
                      <StackPanel>
                        <Border Height="74" Background="#10221D" BorderBrush="#B7D39B" BorderThickness="1" CornerRadius="5" />
                        <TextBlock Text="森林" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,0" />
                        <TextBlock Text="自然深绿，温和沉静" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </StackPanel>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
        <Grid x:Name="CrosshairView" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}">
          <Grid.Resources><ResourceDictionary Source="OverlaySettingsResources.xaml" /></Grid.Resources>
          <Grid Margin="32,24,32,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="屏幕准心" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="在屏幕中央放置清晰、轻量的静态标记。" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0" /></StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center"><CheckBox x:Name="CrosshairEnabledBox" Style="{StaticResource EdgeOverlaySwitch}" Content="启用准心" Click="CrosshairControls_Changed" AutomationProperties.Name="启用屏幕准心" /><TextBlock x:Name="CrosshairSummaryText" Text="已关闭" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,3,0,0" /></StackPanel>
            </Grid>
            <ScrollViewer x:Name="CrosshairScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" CornerRadius="0" Padding="0" VerticalAlignment="Top">
                  <StackPanel>
                    <TextBlock Text="样式与颜色" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="从三种形状开始，调整到顺眼的大小。" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,6,0,22" />
                    <TextBlock Text="准心样式" /><ComboBox x:Name="CrosshairShapeBox" AutomationProperties.Name="准心样式" SelectionChanged="CrosshairControls_Changed"><ComboBoxItem Content="圆形" /><ComboBoxItem Content="十字" /><ComboBoxItem Content="菱形" /></ComboBox>
                    <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="尺寸" /><ComboBox x:Name="CrosshairSizeBox" AutomationProperties.Name="准心尺寸" SelectionChanged="CrosshairControls_Changed"><ComboBoxItem Content="2XS" /><ComboBoxItem Content="XS" /><ComboBoxItem Content="S" /><ComboBoxItem Content="M" /><ComboBoxItem Content="L" /><ComboBoxItem Content="XL" /><ComboBoxItem Content="2XL" /></ComboBox></StackPanel>
                      <StackPanel Grid.Column="2"><TextBlock Text="粗细" /><ComboBox x:Name="CrosshairThicknessBox" AutomationProperties.Name="准心粗细" SelectionChanged="CrosshairControls_Changed"><ComboBoxItem Content="2XS" /><ComboBoxItem Content="XS" /><ComboBoxItem Content="S" /><ComboBoxItem Content="M" /><ComboBoxItem Content="L" /><ComboBoxItem Content="XL" /><ComboBoxItem Content="2XL" /></ComboBox></StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,24" />
                    <TextBlock Text="准心颜色" Margin="0,0,0,8" />
                    <UniformGrid Columns="4">
                      <Button Style="{StaticResource SecondaryButton}" Tag="#FF0000" Click="CrosshairColorPresetButton_Click" Padding="8,8" Margin="0,0,6,0" AutomationProperties.Name="准心红色"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Border Width="9" Height="9" CornerRadius="4.5" Background="#FF0000" Tag="ThemePreview" Margin="0,0,7,0" /><TextBlock Text="红" /></StackPanel></Button>
                      <Button Style="{StaticResource SecondaryButton}" Tag="#00FF00" Click="CrosshairColorPresetButton_Click" Padding="8,8" Margin="0,0,6,0" AutomationProperties.Name="准心绿色"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Border Width="9" Height="9" CornerRadius="4.5" Background="#00FF00" Tag="ThemePreview" Margin="0,0,7,0" /><TextBlock Text="绿" /></StackPanel></Button>
                      <Button Style="{StaticResource SecondaryButton}" Tag="#0099FF" Click="CrosshairColorPresetButton_Click" Padding="8,8" Margin="0,0,6,0" AutomationProperties.Name="准心蓝色"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Border Width="9" Height="9" CornerRadius="4.5" Background="#0099FF" Tag="ThemePreview" Margin="0,0,7,0" /><TextBlock Text="蓝" /></StackPanel></Button>
                      <Button x:Name="CrosshairCustomColorButton" Style="{StaticResource SecondaryButton}" Content="自定义" Click="CrosshairCustomColorButton_Click" Padding="8,8" AutomationProperties.Name="恢复上次自定义准心颜色" />
                    </UniformGrid>
                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
