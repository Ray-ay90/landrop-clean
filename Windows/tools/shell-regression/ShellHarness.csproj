<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>false</PublishSingleFile>
    <LanDropAssemblyPath Condition="'$(LanDropAssemblyPath)' == ''">../../src/bin/Release/net8.0-windows/LanDrop.dll</LanDropAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="LanDrop"><HintPath>$(LanDropAssemblyPath)</HintPath></Reference>
  </ItemGroup>
</Project>
