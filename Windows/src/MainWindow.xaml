                        <StackPanel Grid.Column="2"><TextBlock Text="长度档位" /><ComboBox x:Name="EdgeOverlayLengthBox" AutomationProperties.Name="长度档位" SelectionChanged="EdgeOverlayControls_Changed"><ComboBoxItem Content="0（默认）" /><ComboBoxItem Content="1" /><ComboBoxItem Content="2" /><ComboBoxItem Content="3" /><ComboBoxItem Content="4" /><ComboBoxItem Content="5" /><ComboBoxItem Content="6" /></ComboBox></StackPanel>
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,24" />
                      <TextBlock Text="显示位置" />
                      <ComboBox x:Name="EdgeOverlayDisplayModeBox" AutomationProperties.Name="显示位置" SelectionChanged="EdgeOverlayControls_Changed"><ComboBoxItem Content="前台窗口" /><ComboBoxItem Content="屏幕" /></ComboBox>
                      <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="屏幕比例" /><ComboBox x:Name="EdgeOverlayAspectRatioBox" AutomationProperties.Name="屏幕比例" SelectionChanged="EdgeOverlayControls_Changed"><ComboBoxItem Content="全屏" /><ComboBoxItem Content="21:9" /><ComboBoxItem Content="4:3" /><ComboBoxItem Content="5:4" /></ComboBox></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="分屏" /><ComboBox x:Name="EdgeOverlaySplitBox" AutomationProperties.Name="分屏" SelectionChanged="EdgeOverlayControls_Changed"><ComboBoxItem Content="不分屏" /><ComboBoxItem Content="左右分屏" /><ComboBoxItem Content="上下分屏" /></ComboBox></StackPanel>
