                        <TextBlock Text="上" VerticalAlignment="Center" /><Slider Grid.Column="1" x:Name="EdgeOverlayTopOpacitySlider" AutomationProperties.Name="上边不透明度" ValueChanged="EdgeOverlayControls_Changed" /><TextBlock Grid.Column="2" Text="{Binding ElementName=EdgeOverlayTopOpacitySlider, Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="下" VerticalAlignment="Center" /><Slider Grid.Row="1" Grid.Column="1" x:Name="EdgeOverlayBottomOpacitySlider" AutomationProperties.Name="下边不透明度" ValueChanged="EdgeOverlayControls_Changed" /><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ElementName=EdgeOverlayBottomOpacitySlider, Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="左" VerticalAlignment="Center" /><Slider Grid.Row="2" Grid.Column="1" x:Name="EdgeOverlayLeftOpacitySlider" AutomationProperties.Name="左边不透明度" ValueChanged="EdgeOverlayControls_Changed" /><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ElementName=EdgeOverlayLeftOpacitySlider, Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Text="右" VerticalAlignment="Center" /><Slider Grid.Row="3" Grid.Column="1" x:Name="EdgeOverlayRightOpacitySlider" AutomationProperties.Name="右边不透明度" ValueChanged="EdgeOverlayControls_Changed" /><TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding ElementName=EdgeOverlayRightOpacitySlider, Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </Grid>
              </ScrollViewer>
            </Grid>
            <TextBlock x:Name="EdgeOverlayStatusText" Grid.Row="3" Text="调整会自动保存，启用后立即生效。叠加层不影响鼠标点击。" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0" />
          </Grid>
