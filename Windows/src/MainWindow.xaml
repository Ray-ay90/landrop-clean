                      <UniformGrid Columns="4"><CheckBox x:Name="EdgeOverlayTopVisibleBox" Content="上" AutomationProperties.Name="上边" Click="EdgeOverlayControls_Changed" /><CheckBox x:Name="EdgeOverlayBottomVisibleBox" Content="下" AutomationProperties.Name="下边" Click="EdgeOverlayControls_Changed" /><CheckBox x:Name="EdgeOverlayLeftVisibleBox" Content="左" AutomationProperties.Name="左边" Click="EdgeOverlayControls_Changed" /><CheckBox x:Name="EdgeOverlayRightVisibleBox" Content="右" AutomationProperties.Name="右边" Click="EdgeOverlayControls_Changed" /></UniformGrid>
                      <Grid Margin="0,20,0,0"><TextBlock Text="不透明度" /><TextBlock Text="{Binding ElementName=EdgeOverlayOpacitySlider, Path=Value, StringFormat={}{0:0}%}" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" /></Grid>
                      <Slider x:Name="EdgeOverlayOpacitySlider" Margin="0,6,0,0" AutomationProperties.Name="统一不透明度" ValueChanged="EdgeOverlayControls_Changed" />
